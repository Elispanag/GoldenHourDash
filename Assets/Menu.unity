    \u0386\u03BB\u03BC\u03B1 \u03C0\u03AC\u03BD\u03C9 \u03B1\u03C0\u03CC \u03B5\u03BC\u03C0\u03CC\u03B4\u03B9\u03B1\n\n\u03A3\u039A\u039F\u03A0\u039F\u03A3:
    \u0395\u03C0\u03B9\u03B2\u03AF\u03C9\u03C3\u03B5 \u03B3\u03B9\u03B1 \u03CC\u03C3\u03BF
    \u03C0\u03B5\u03C1\u03B9\u03C3\u03C3\u03CC\u03C4\u03B5\u03C1\u03BF \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF\u03C2
    \u03C7\u03C9\u03C1\u03AF\u03C2 \u03BD\u03B1 \u03C7\u03C4\u03C5\u03C0\u03AE\u03C3\u03B5\u03B9\u03C2
    \u03C3\u03C4\u03B1 \u03B5\u03BC\u03C0\u03CC\u03B4\u03B9\u03B1!"
